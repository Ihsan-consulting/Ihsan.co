# Copy to .env.local and fill in. Never commit the filled file.
# Mirrors the zod schema in src/lib/env.ts — adding a variable there means adding it here.

# --- Supabase ---------------------------------------------------------------
# The service-role key bypasses RLS and is the only credential that can read these
# tables. Server-side only. Never expose it to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# --- Fathom -----------------------------------------------------------------
# FATHOM_WEBHOOK_SECRET is returned by Fathom when the webhook is created and is what
# verifies the Svix signature on every incoming call.
FATHOM_WEBHOOK_SECRET=whsec_<secret>
FATHOM_API_KEY=<api-key>

# --- Gemini (Anthropic is intentionally NOT used) ---------------------------
GEMINI_API_KEY=<gemini-key>
GEMINI_MODEL=gemini-3.6-flash

# --- Discord ----------------------------------------------------------------
DISCORD_DEFAULT_WEBHOOK_URL=https://discord.com/api/webhooks/<id>/<token>

# --- Google Drive / Docs (opcional) ------------------------------------------
# Espeja cada reunión en un Google Doc dentro de GOOGLE_DRIVE_FOLDER_ID.
# Las CUATRO son opcionales: si falta alguna, el export no se intenta y el brief de
# Gemini y la publicación en Discord siguen funcionando igual.
#
# Cuenta de servicio de Google Cloud, con la Drive API habilitada en el proyecto.
# GOOGLE_DRIVE_FOLDER_ID es el id que aparece en la URL de la carpeta:
#   https://drive.google.com/drive/folders/<ESTO-DE-AQUI>
# La carpeta TIENE que estar compartida con GOOGLE_SERVICE_ACCOUNT_EMAIL como Editor:
# la cuenta de servicio no ve nada de tu Drive hasta que la compartes, y sin ese paso
# la creación falla con 404 aunque las credenciales sean correctas.
#
# GOOGLE_PRIVATE_KEY se guarda entre comillas y con `\n` LITERALES de dos caracteres
# (así sobrevive a una variable de entorno). El código los convierte en saltos de línea
# reales antes de firmar; sin esa conversión la autenticación falla con un error opaco.
GOOGLE_SERVICE_ACCOUNT_EMAIL=<nombre>@<project-id>.iam.gserviceaccount.com
GOOGLE_PROJECT_ID=<project-id>
GOOGLE_DRIVE_FOLDER_ID=<id-de-la-carpeta-de-drive>
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQIBADAN...\n-----END PRIVATE KEY-----\n"

# --- Dashboard access -------------------------------------------------------
# DASHBOARD_PASSWORD: shared password for the internal dashboard. The schema enforces a
# 24-character minimum — a shorter value makes every route answer 503 until it is fixed.
# SESSION_SECRET: min 32 chars, e.g. `openssl rand -base64 32`. Rotating it logs everyone out.
DASHBOARD_PASSWORD=<long-random-password>
SESSION_SECRET=<32+ char random string>
